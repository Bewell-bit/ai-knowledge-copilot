{
  "name": "ai-knowledge-copilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @copilot/api dev\" \"pnpm --filter @copilot/web dev\"",
    "build": "pnpm --filter @copilot/api build && pnpm --filter @copilot/web build",
    "test": "pnpm --filter @copilot/api test",
    "typecheck": "pnpm --filter @copilot/api typecheck && pnpm --filter @copilot/web typecheck",
    "start": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @copilot/api start\" \"pnpm --filter @copilot/web start\""
  },
  "engines": {
    "node": ">=22.5 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
